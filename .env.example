# Read only on the server. Never use a VITE_ prefix for secrets.
# Copy values into a mode-0600 .env or an explicit server environment. Empty keeps all CNB access disabled.
ZHANGDUO_MODE=
ZHANGDUO_BOOTSTRAP_KEY=
ZHANGDUO_STATE_FILE=.local/live/operations.sqlite
ZHANGDUO_STORAGE_CONFIRMED=false
# The intelligence overview reads approved use records; activity pages need audit:read.
# Keep this read-only. Grant write/model/export/delete scopes separately for approved workflows.
ZHANGDUO_APP_SCOPES=workspace:read,conversation:read,candidate:read,draft:read,task:read,knowledge:read,evidence:read,settings:read,audit:read
# Saving a private task additionally needs task:write and per-save 30-day consent.
CNB_REPO_SLUG=
CNB_TOKEN=
CNB_AI_MODEL=
# Each live side effect needs separate user authorization. Empty means disabled.
CNB_LIVE_READS_FOR=
CNB_LIVE_WRITES_FOR=
CNB_LIVE_AI_FOR=
CNB_LIVE_QUERIES_FOR=
# Separate controlled index/pipeline authorization. Never enabled by ordinary Git/Issue writes.
CNB_LIVE_INDEX_FOR=
CNB_INDEX_EMBEDDING_MODEL=
# Reviewed, immutable private catalog; optional. Requires a regular mode-0600 file and explicit 30-day retention.
ZHANGDUO_REVIEW_CATALOG_FILE=
# Live AI remains closed until pipeline-token use and model output limits are verified.
# CNB_BUILD_ID is supplied by CNB, not a substitute for user authorization.
CNB_LIVE_AI_PIPELINE_FOR=
CNB_AI_OUTPUT_LIMIT_VERIFIED=false
# Explicit token permissions, never inferred from client claims.
CNB_TOKEN_SCOPES=account-profile:r,repo-basic-info:r,repo-issue:r,repo-code:r
# Read-only verification command only; not application authorization.
CNB_VERIFY_READS_FOR=
CNB_VERIFY_ISSUE=
CNB_VERIFY_REF=
CNB_VERIFY_KNOWLEDGE=false
API_PORT=4311
WEB_PORT=4310
# Optional inference adapters. Keys are server-only; nothing is prefilled or auto-discovered.
ZHANGDUO_OPENAI_API_KEY=
ZHANGDUO_OPENAI_MODEL=
# Loopback HTTP only; base URL must include /v1 when required by your local server.
ZHANGDUO_LOCAL_AI_URL=
ZHANGDUO_LOCAL_AI_MODEL=
# Absolute path to an already-downloaded safetensors model, never a shell command or remote-code model.
ZHANGDUO_TRAIN_BASE=
